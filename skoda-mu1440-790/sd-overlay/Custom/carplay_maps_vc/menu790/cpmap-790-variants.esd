###########################################################################
# MHI2-Carplay-Maps 790 v2 - MU1440/790 variants (by D., based on omonob 2.0.1)
# Swaps core.so only. Full reboot after any switch.
###########################################################################
screen cpmap-790-variants carplay-maps-vc

keyValue
    value   String sys 0x00000000 0
    label   "MHI2-Carplay-Maps 790 v2. Keep the SD card inserted. Reboot after switching."
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Card side: App-Connect > Virtual Cockpit settings (Left or Right)."
    poll    0

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_variant_YANDEX-2026.sh"
    label   "YANDEX-2026: zones for Yandex, card + ETA, 30 fps (default)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_variant_OMONOB201.sh"
    label   "OMONOB 2.0.1 classic (unchanged, 60 fps, no ETA)"

script
    value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/cpmap_variant_show.sh"
    label   "Show variant, card side and RAM disk usage"
